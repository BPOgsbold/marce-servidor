# Copia este archivo como ".env" y completa tus llaves reales.

# API key de Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo de Claude a usar para resolver dudas del asesor
ANTHROPIC_MODEL=claude-sonnet-4-5

# Supabase - https://app.supabase.com/  -> Project Settings > API
SUPABASE_URL=
# Usa la "service_role" key (no la anon) porque este backend escribe datos.
# Nunca expongas esta llave en la extensión ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=




# Puerto del servidor
PORT=3000
